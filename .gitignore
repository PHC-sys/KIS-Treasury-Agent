# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── 대용량 / 재생성 가능 — 제외 ─────────────────────────
# raw: 원본 응답 아카이브(약 95MB, 재생성 가능)
raw/
# db: ledger sqlite(약 32MB) — infomax_data.xlsx + 공개소스로 재구성 가능
db/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ── 내부자료 / 라이선스 — 제외 ──────────────────────────
# data: 차장님 체크리스트(시그널 설계=알파) — 공개 보류
data/
# manual_input: S&P CDS 라이선스 → 템플릿(manual_input.csv.example)만 공개
manual_input.csv
# 산출 보고서(내부 배포용) — 루트의 docx/pdf만 제외. Infomax Manual/ 의 PDF는 포함.
/*.docx
/*.pdf

# ── 시크릿 (절대 커밋 금지) ───────────────────────────
.env
*.env
*.key
*.pem
secret*

# 포함되는 것(인포맥스 확인 완료): infomax_data.xlsx, out/ktb_daily.csv, Infomax Manual/
